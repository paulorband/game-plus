<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Central de Jogo: design tokens (overlay-design.html) -->
    <Color x:Key="PanelColor">#F00E1118</Color>
    <Color x:Key="Surface1Color">#141922</Color>
    <Color x:Key="Surface2Color">#1A202B</Color>
    <Color x:Key="Surface3Color">#252E3D</Color>
    <Color x:Key="AccentColor">#35D8A0</Color>
    <Color x:Key="FocusColor">#F2F6FF</Color>

    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="PageBrush" Color="#0A0D12"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#04231A"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#A5AFC0"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#6C778A"/>
    <SolidColorBrush x:Key="KeyBrush" Color="#39445A"/>
    <SolidColorBrush x:Key="BtnABrush" Color="#5BC236"/>
    <SolidColorBrush x:Key="BtnBBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="BtnXBrush" Color="#3D8BFF"/>
    <SolidColorBrush x:Key="BtnYBrush" Color="#F5C400"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
        <Setter Property="Margin" Value="16,12,0,4"/>
    </Style>

    <!-- Invisible button: only gives its content a click target -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource FocusBrush}"/>
                <Setter Property="Foreground" Value="#0B0E14"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1FFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwitchButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Track" Width="52" Height="30" CornerRadius="15" Background="#3A4354">
                        <Ellipse x:Name="Knob" Width="22" Height="22" Fill="#C7CEDA"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large switch (68x38, knob 30) used by the master card -->
    <Style x:Key="SwitchButtonLarge" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Track" Width="68" Height="38" CornerRadius="19" Background="#3A4354">
                        <Ellipse x:Name="Knob" Width="30" Height="30" Fill="#C7CEDA"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="0,6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Thin vertical scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="4" Background="#0DFFFFFF">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#47FFFFFF" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
