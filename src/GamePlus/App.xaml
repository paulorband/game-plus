<Application x:Class="GamePlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeManager swaps the Colors.* entry at runtime; Theme.xaml holds the styles. -->
                <ResourceDictionary Source="Overlay/Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Overlay/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
