<Window x:Class="GamePlus.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Plus"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="920" Height="580"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Focusable="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Standard setting row -->
            <DataTemplate x:Key="RowTemplate">
                <Border x:Name="Bd" MinHeight="52" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                        BorderThickness="2" BorderBrush="Transparent" Margin="0,0,0,8" Padding="16,6,8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding Hint}" FontSize="12.5" Foreground="{StaticResource Text3Brush}" Margin="0,1,0,0"
                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <Grid Grid.Column="1" Width="220" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Stepper -->
                            <Grid Visibility="{Binding IsStepper, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ArrowButton}" Click="OnDecrementClick">
                                    <Path Data="M10,1 L3,7 L10,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                            Background="{Binding Swatch}" Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource ArrowButton}" Click="OnIncrementClick">
                                    <Path Data="M4,1 L11,7 L4,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <!-- Toggle -->
                            <Button Style="{StaticResource SwitchButton}" HorizontalAlignment="Right" Click="OnIncrementClick"
                                    Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}"/>

                            <!-- Segmented -->
                            <Border Background="{StaticResource PageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="3"
                                    Visibility="{Binding IsSegmented, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}" Style="{StaticResource SegmentButton}" Margin="1,0" Click="OnSegmentClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Position picker (3x3) -->
                            <Border HorizontalAlignment="Right" Background="{StaticResource PageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Margin="0,4"
                                    Visibility="{Binding IsPosition, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PositionCell}" Click="OnSegmentClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Slider -->
                            <Grid Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="28" Background="Transparent" Cursor="Hand" Margin="0,0,9,0"
                                      MouseLeftButtonDown="OnSliderMouse" MouseMove="OnSliderMouse">
                                    <Border Height="6" CornerRadius="3" Background="#333C4C"/>
                                    <Grid Height="6" IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding FillWidth}"/>
                                            <ColumnDefinition Width="{Binding RestWidth}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Fill" CornerRadius="3" Background="{StaticResource Text2Brush}"/>
                                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#C7CEDA" HorizontalAlignment="Right"
                                                 Margin="0,0,-9,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                        <Setter TargetName="Bd" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#35D8A0" Opacity=".25" BlurRadius="24" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource FocusBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Available}" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                        <Setter TargetName="Bd" Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Master card: Lossless Scaling state + toggle -->
            <DataTemplate x:Key="MasterTemplate">
                <Border x:Name="Bd" CornerRadius="14" BorderThickness="2" BorderBrush="#59FFFFFF" Margin="0,0,0,8" Padding="20,14,16,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2">
                            <GradientStop Color="#2935D8A0" Offset="0"/>
                            <GradientStop Color="#0A35D8A0" Offset="0.6"/>
                            <GradientStop Color="#141922" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Text3Brush}" Margin="0,1,8,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="13.5" Foreground="{StaticResource Text2Brush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Pills}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="#0FFFFFFF" Padding="8,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PlainButton}" VerticalAlignment="Center" Padding="0" Click="OnIncrementClick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BtnABrush}" Margin="0,0,12,0">
                                    <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="#0B0E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="SwitchVisual" Style="{StaticResource SwitchButtonLarge}" IsHitTestVisible="False" Focusable="False"
                                        Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVis}}"/>
                                <Border CornerRadius="10" Background="{StaticResource BtnYBrush}" Padding="16,8"
                                        Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Baixar na Steam" FontSize="15" FontWeight="Bold" Foreground="#0B0E14"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource BtnYBrush}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#80F5C400"/>
                        <Setter TargetName="Bd" Property="Background" Value="#1AF5C400"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource BtnYBrush}"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="BusyPulse">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="BusyPulse"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusOn}" Value="True">
                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                        <Setter TargetName="StatusDot" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#35D8A0" Opacity="1" BlurRadius="8" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#5935D8A0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                        <Setter TargetName="Bd" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#35D8A0" Opacity=".3" BlurRadius="24" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="ItemTemplate">
                <StackPanel>
                    <TextBlock Text="{Binding Section}" Style="{StaticResource SectionText}"
                               TextOptions.TextFormattingMode="Display"
                               Visibility="{Binding HasSection, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource RowTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource MasterTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="RowContainer" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="KeyPill" TargetType="Border">
                <Setter Property="MinWidth" Value="28"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Background" Value="{StaticResource KeyBrush}"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragWindow">
                <Grid Margin="24,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- App icon (app-icon.svg): controller silhouette with a lightning bolt -->
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#35D8A0" Offset="0"/>
                                    <GradientStop Color="#1B9C78" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Width="32" Height="28">
                                <Canvas Width="32" Height="28">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform Y="-1.4"/>
                                    </Canvas.RenderTransform>
                                    <Path Fill="{StaticResource AccentDarkBrush}">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                                <PathGeometry Figures="M9 8H23C26.5 8 28.5 10.5 29.5 15L30.8 22C31.3 25 29.5 27 27 27C25 27 24 26 23 24.5L22 23C21.5 22.3 21 22 20 22H12C11 22 10.5 22.3 10 23L9 24.5C8 26 7 27 5 27C2.5 27 .7 25 1.2 22L2.5 15C3.5 10.5 5.5 8 9 8Z"/>
                                                <PathGeometry Figures="M5.6,11.6 H7.2 V13.7 H9.1 V15.3 H7.2 V17.4 H5.6 V15.3 H3.7 V13.7 H5.6 Z"/>
                                                <EllipseGeometry Center="25.6,12.1" RadiusX="1.1" RadiusY="1.1"/>
                                                <EllipseGeometry Center="25.6,16.9" RadiusX="1.1" RadiusY="1.1"/>
                                                <EllipseGeometry Center="23.2,14.5" RadiusX="1.1" RadiusY="1.1"/>
                                                <EllipseGeometry Center="28,14.5" RadiusX="1.1" RadiusY="1.1"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Data="M18 1.5 11.5 15.5H15.5L13.5 27 21 11.5H16.8Z" Fill="#2FCB98"
                                          Stroke="{StaticResource AccentDarkBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Game Plus" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ProfileChip" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="999" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyPill}" Margin="0">
                                    <TextBlock Text="LT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ProfileNameText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="ProfileCountText" FontSize="12" Foreground="{StaticResource Text3Brush}"
                                           VerticalAlignment="Center" Margin="6,0,10,0"/>
                                <Border Style="{StaticResource KeyPill}" Margin="0">
                                    <TextBlock Text="RT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button Content="✕" Style="{StaticResource PlainButton}" Width="36" Height="36" Margin="12,0,0,0"
                                FontSize="16" Foreground="{StaticResource Text2Brush}" Click="OnCloseClick" ToolTip="Fechar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#04FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                    <DockPanel>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" Margin="12,8,4,0" MinHeight="18"/>
                        <StackPanel>
                            <TextBlock Text="CATEGORIAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text3Brush}" Margin="12,0,0,8"/>
                            <Border x:Name="RailLs" Height="48" CornerRadius="10" Background="{StaticResource Surface3Brush}" Padding="12,0" Cursor="Hand"
                                    MouseLeftButtonDown="OnRailLsClick">
                                <DockPanel VerticalAlignment="Center">
                                    <Path DockPanel.Dock="Left" Data="M11,2 L4,11 L9,11 L8,18 L16,8 L11,8 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <Ellipse x:Name="RailDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Lossless Scaling" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="RailMon" Height="48" CornerRadius="10" Background="Transparent" Padding="12,0" Margin="0,4,0,0" Cursor="Hand"
                                    MouseLeftButtonDown="OnRailMonClick">
                                <DockPanel VerticalAlignment="Center">
                                    <Path DockPanel.Dock="Left" Data="M3,14 A7,7 0 1 1 17,14 M10,14 L13,9" Stroke="{StaticResource Text2Brush}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                                    <Ellipse x:Name="MonDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" Visibility="Hidden"/>
                                    <TextBlock Text="Monitoramento" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox Grid.Column="1" x:Name="RowsList"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         Margin="20,16,10,0" Padding="0,0,14,32"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource ItemTemplate}"
                         ItemContainerStyle="{StaticResource RowContainer}"
                         SelectionChanged="OnSelectionChanged"/>
            </Grid>

            <!-- Hint bar -->
            <Border Grid.Row="2" Background="#40000000" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    MouseLeftButtonDown="OnDragWindow">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Data="M8,1 L14,1 L14,8 L21,8 L21,14 L14,14 L14,21 L8,21 L8,14 L1,14 L1,8 L8,8 Z" Fill="{StaticResource KeyBrush}"
                              Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Navegar / ajustar" Style="{StaticResource HintText}" Margin="0,0,20,0"/>

                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BtnABrush}" Margin="0,0,8,0">
                            <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="#0B0E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="HintAText" Text="Alternar" Style="{StaticResource HintText}" Margin="0,0,20,0"/>

                        <Button x:Name="RestartHint" Style="{StaticResource PlainButton}" Padding="0" Margin="0,0,20,0" Click="OnRestartClick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BtnXBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="X" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Reiniciar LS" Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SaveHint" Style="{StaticResource PlainButton}" Padding="0" Click="OnSaveClick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BtnYBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="Y" FontSize="12" FontWeight="Bold" Foreground="#0B0E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Salvar perfil" Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Style="{StaticResource KeyPill}">
                            <TextBlock Text="LB" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource KeyPill}">
                            <TextBlock Text="RB" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Categoria" Style="{StaticResource HintText}" Margin="4,0,20,0"/>
                        <StackPanel x:Name="ProfileHint" Orientation="Horizontal">
                            <Border Style="{StaticResource KeyPill}">
                                <TextBlock Text="LT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource KeyPill}">
                                <TextBlock Text="RT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Perfil" Style="{StaticResource HintText}" Margin="4,0,20,0"/>
                        </StackPanel>

                        <Button Style="{StaticResource PlainButton}" Padding="0" Click="OnCloseClick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BtnBBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="B" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Fechar" Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
