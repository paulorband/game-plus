<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Game Plus: design tokens (overlay-design.html) -->
    <!-- Colors live in Themes\Colors.Dark.xaml / Colors.Light.xaml (swapped at runtime by ThemeManager); fixed art colors below. -->
    <SolidColorBrush x:Key="IconDarkBrush" Color="#04231A"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        <Setter Property="Margin" Value="16,12,0,4"/>
    </Style>

    <!-- Invisible button: only gives its content a click target -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource FocusBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnFocusBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwitchButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Track" Width="52" Height="30" CornerRadius="15" Background="{DynamicResource SwitchOffBrush}">
                        <Ellipse x:Name="Knob" Width="22" Height="22" Fill="{DynamicResource KnobBrush}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource KnobOnBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large switch (68x38, knob 30) used by the master card -->
    <Style x:Key="SwitchButtonLarge" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Track" Width="68" Height="38" CornerRadius="19" Background="{DynamicResource SwitchOffBrush}">
                        <Ellipse x:Name="Knob" Width="30" Height="30" Fill="{DynamicResource KnobBrush}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource KnobOnBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="0,6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One cell of the 3x3 screen-position picker -->
    <Style x:Key="PositionCell" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource PositionCellBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Text2Brush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Thin vertical scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="4" Background="{DynamicResource ScrollTrackBrush}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
